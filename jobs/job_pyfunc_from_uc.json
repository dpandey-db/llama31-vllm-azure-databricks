{
  "name": "deploy-llama31-8b-pyfunc-from-uc",
  "max_concurrent_runs": 1,
  "queue": {
    "enabled": true
  },
  "tasks": [
    {
      "task_key": "deploy",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/<your-user>/llama31-vllm/deploy_llama31_8b_pyfunc_from_uc",
        "source": "WORKSPACE",
        "base_parameters": {
          "source_model": "<catalog>.<schema>.<fine_tuned_model>",
          "source_version": "1",
          "chat_template_path": "",
          "catalog": "<catalog>",
          "schema": "<schema>",
          "model_name": "llama31_8b_finetuned_pyfunc",
          "endpoint": "llama31-8b-finetuned-pyfunc",
          "workload_type": "GPU_LARGE",
          "vllm_version": "0.24.0",
          "scale_to_zero": "false"
        }
      },
      "timeout_seconds": 0,
      "environment_key": "std_v6_cpu"
    }
  ],
  "environments": [
    {
      "environment_key": "std_v6_cpu",
      "spec": {
        "environment_version": "6"
      }
    }
  ]
}
